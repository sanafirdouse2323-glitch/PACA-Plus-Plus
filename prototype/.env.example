# Copy to .env and replace every REPLACE_ME value before starting the service.
# This file is an example only; do not commit real credentials.

# OIDC provider: issuer and audience must match your identity provider configuration.
OIDC_ISSUER=https://REPLACE_ME_IDP.example/
OIDC_AUDIENCE=paca-api
OIDC_JWKS_URL=https://REPLACE_ME_IDP.example/.well-known/jwks.json

# This trusted service must derive roles, capabilities, resource attributes, and current suspension state server-side.
PACA_CONTEXT_URL=https://REPLACE_ME_CONTEXT.example/v1/attributes
PACA_CONTEXT_SERVICE_TOKEN=REPLACE_ME_WITH_A_SECRET_AT_LEAST_16_CHARACTERS
# Only set true when calling the reference context service over loopback HTTP in local development.
PACA_CONTEXT_ALLOW_INSECURE_LOCALHOST=false
# Context-service runtime DSN; use a distinct read-only DB role in production.
PACA_CONTEXT_DATABASE_URL=postgresql://paca:paca-test-only-password@127.0.0.1:5432/paca_test

# Local OPA instance from prototype/compose.yaml; change to an authenticated HTTPS URL in production.
OPA_URL=http://127.0.0.1:8181
OPA_BEARER_TOKEN=

# Local development database from the compose profile. Credentials below are development-only.
PACA_DATABASE_URL=postgresql://paca:paca-test-only-password@127.0.0.1:5432/paca_test
PACA_DATABASE_AUTO_MIGRATE=true
# In production, apply all numbered migrations as a migration role and set this to false.
# Alternatively, for a single-host sandbox only, unset PACA_DATABASE_URL and set:
# PACA_SQLITE_PATH=./data/paca.sqlite3

# The API receives the ticket argument object as JSON and must honor Idempotency-Key durably.
PACA_PROTECTED_API_BASE_URL=https://REPLACE_ME_DOWNSTREAM.example
PACA_PROTECTED_API_TOKEN=REPLACE_ME_WITH_A_DOWNSTREAM_SECRET
PACA_TICKET_CREATE_PATH=/v1/tickets

# Audit outbox exporter. The receiver must durably deduplicate event_id and
# enforce independent append-only/WORM retention; a normal HTTP endpoint alone is not immutable storage.
PACA_AUDIT_SINK_URL=https://REPLACE_ME_AUDIT.example/v1/events
PACA_AUDIT_SINK_TOKEN=REPLACE_ME_WITH_AUDIT_SINK_SECRET
PACA_AUDIT_BATCH_SIZE=100
PACA_AUDIT_POLL_SECONDS=5
# Optional unique ID for this exporter process.
# PACA_AUDIT_WORKER_ID=audit-exporter-01
