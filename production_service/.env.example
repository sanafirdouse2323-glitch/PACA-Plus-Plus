# Copy to .env and replace the placeholders before starting the local Compose stack.
# Generate two independent secrets with separate openssl rand -hex 32 invocations.
# Used by the PostgreSQL bootstrap/admin role; the API does not use this credential.
POSTGRES_PASSWORD=replace_with_random_admin_secret
# Used by the API's restricted paca_runtime database role.
PACA_RUNTIME_PASSWORD=replace_with_random_runtime_secret
# Generate 32 random bytes (openssl rand -hex 32). Keep identical in DB and API
# secret stores; this example value is public and MUST be replaced outside CI.
PACA_TENANT_CONTEXT_HMAC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PACA_TENANT_CONTEXT_KEY_ID=v1

# OPA is reachable only on the private Compose network. Use HTTPS plus a
# dedicated bearer credential for remote OPA. Do not reuse the end-user token.
PACA_OPA_URL=http://opa:8181
PACA_OPA_DECISION_PATH=/v1/data/paca/authz/decision
# Must exactly match production_service/opa/data.json.
PACA_EXPECTED_POLICY_REVISION=paca-dev-2026-10-23
PACA_OPA_TIMEOUT_SECONDS=2
# Choose ONE remote OPA credential mode:
# (A) pre-provisioned static service token (legacy):
PACA_OPA_BEARER_TOKEN=
# (B) OAuth 2.0 client_credentials with client_secret_basic (preferred):
# Configure a separate confidential client in the identity provider, with only
# the OPA decision scope. Inject the client secret from a secrets manager.
PACA_OPA_OAUTH_TOKEN_URL=
PACA_OPA_OAUTH_CLIENT_ID=
PACA_OPA_OAUTH_CLIENT_SECRET=
PACA_OPA_OAUTH_SCOPE=

# NON-WORKING PLACEHOLDERS, not a configured external identity tenant.
# Read the provider's /.well-known/openid-configuration document and copy its
# exact "issuer" and "jwks_uri" values. The access token must have audience
# paca-api, a trusted tenant_id claim, and an issuer-controlled token_use=access
# claim included in access tokens only (not ID tokens); see IDENTITY_PROVIDER.md.
PACA_JWT_ISSUER=https://identity.example.org/
PACA_JWT_AUDIENCE=paca-api
PACA_JWT_JWKS_URL=https://identity.example.org/.well-known/jwks.json
PACA_JWT_TOKEN_USE_CLAIM=token_use
PACA_JWT_EXPECTED_TOKEN_USE=access
PACA_JWT_TIMEOUT_SECONDS=5

PACA_PERMIT_TTL_SECONDS=30
PACA_EXECUTION_TIMEOUT_SECONDS=10
# Choose a stale-execution recovery threshold manually for administrator-only recovery.
PACA_FILE_ROOT=/var/lib/paca/files

# Optional routes are fixed server configuration, never caller-controlled URLs.
# Remote upstreams must use HTTPS and honor Idempotency-Key for mutations.
# All non-2xx outcomes are unknown unless a specific route explicitly documents
# which 4xx statuses guarantee that no effect was applied. See README.md.
PACA_API_BASE_URL=
PACA_API_ROUTES_JSON={}
# Choose ONE remote downstream API credential mode:
# (A) pre-provisioned static service token (legacy):
PACA_API_BEARER_TOKEN=
# (B) an independent OAuth 2.0 client_credentials client:
# Do not reuse the OPA OAuth client, user access token, or client secret.
PACA_API_OAUTH_TOKEN_URL=
PACA_API_OAUTH_CLIENT_ID=
PACA_API_OAUTH_CLIENT_SECRET=
PACA_API_OAUTH_SCOPE=
