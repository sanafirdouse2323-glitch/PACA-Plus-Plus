# Copy to .env and replace the placeholders before starting the local Compose stack.
# Generate two independent secrets with separate openssl rand -hex 32 invocations.
# Used by the PostgreSQL bootstrap/admin role; the API does not use this credential.
POSTGRES_PASSWORD=replace_with_random_admin_secret
# Used by the API's restricted paca_runtime database role.
PACA_RUNTIME_PASSWORD=replace_with_random_runtime_secret

# OPA is reachable only on the private Compose network. Use HTTPS for remote OPA.
PACA_OPA_URL=http://opa:8181
PACA_OPA_DECISION_PATH=/v1/data/paca/authz/decision
# Must exactly match production_service/opa/data.json.
PACA_EXPECTED_POLICY_REVISION=paca-dev-2026-10-23
PACA_OPA_TIMEOUT_SECONDS=2

# Replace with the actual OIDC issuer, audience and HTTPS JWKS endpoint.
# The example identity.example.org values are placeholders.
PACA_JWT_ISSUER=https://identity.example.org/
PACA_JWT_AUDIENCE=paca-api
PACA_JWT_JWKS_URL=https://identity.example.org/.well-known/jwks.json
PACA_JWT_TIMEOUT_SECONDS=5

PACA_PERMIT_TTL_SECONDS=30
PACA_EXECUTION_TIMEOUT_SECONDS=10
PACA_STALE_EXECUTION_SECONDS=120
PACA_FILE_ROOT=/var/lib/paca/files

# Optional routes are fixed server configuration, never caller-controlled URLs.
# Remote upstreams must use HTTPS and honor Idempotency-Key for mutations.
PACA_API_BASE_URL=
PACA_API_ROUTES_JSON={}
# Optional upstream service credential; inject from a secrets manager.
PACA_API_BEARER_TOKEN=
