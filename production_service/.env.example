# Copy to .env and replace every example value before starting the local compose stack.
# Create both independently: openssl rand -hex 32
# Admin password is consumed only by the database container during first initialization.
POSTGRES_ADMIN_PASSWORD=replace_with_random_admin_secret
# The API's non-owner database account uses a separate password.
PACA_RUNTIME_PASSWORD=replace_with_random_runtime_secret

# Internal Docker-network service. Use HTTPS when pointing to a remote OPA service.
PACA_OPA_URL=http://opa:8181
PACA_OPA_DECISION_PATH=/v1/data/paca/authz/decision
# Must exactly match production_service/opa/data.json.
PACA_EXPECTED_POLICY_REVISION=paca-dev-2026-10-23
PACA_OPA_TIMEOUT_SECONDS=2

# Use your organization's actual OIDC issuer and JWKS endpoint. HTTPS is required.
PACA_JWT_ISSUER=https://identity.example.org/
PACA_JWT_AUDIENCE=paca-api
PACA_JWT_JWKS_URL=https://identity.example.org/.well-known/jwks.json
PACA_JWT_TIMEOUT_SECONDS=5

PACA_PERMIT_TTL_SECONDS=30
PACA_EXECUTION_TIMEOUT_SECONDS=10
PACA_STALE_EXECUTION_SECONDS=120
# Optional; maps to an isolated volume in this local deployment.
PACA_FILE_ROOT=/var/lib/paca/files

# Optional. Routes are server-controlled, never request-controlled URLs.
# Any mutating upstream must durably honor the Idempotency-Key header.
PACA_API_BASE_URL=
PACA_API_ROUTES_JSON='{}'
# Optional upstream service credential; inject from a secrets manager.
PACA_API_BEARER_TOKEN=
